# Environment variables for the AI SDLC Todo App
# Copy this file to .env.local and adjust values as needed.

DATA_DB_PATH=./data/app.db
AUTH_JWT_SECRET=change-me-in-production
AUTH_RP_ID=localhost
AUTH_RP_ORIGIN=http://localhost:3000
# Update relying party host/origin if you expose the dev server outside localhost.
# Even though the app listens on 0.0.0.0, a concrete hostname (e.g. ip or domain) is required here.
AUTH_RP_NAME=AI SDLC Todo App
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
NOTIFICATIONS_POLL_INTERVAL_SECONDS=30
EXPORT_MAX_PER_HOUR=3
IMPORT_MAX_PER_HOUR=3
